# Source graph for an admitted retained-engine browser producer. The caller
# verifies the exact retained engine/paired SDK before including this fragment;
# no supplier engine source is configured, built or repaired here.
include_guard(GLOBAL)
if(NOT FOUNDATION_APPENDED_PROFILE MATCHES "^(web|both)$")
  message(FATAL_ERROR "The rich appended graph requires the web or both profile")
endif()
if(NOT FOUNDATION_APPENDED_ENGINE_CONSUMER_VERIFIED)
  message(FATAL_ERROR "A pinned retained-engine consumer verification is required before the rich appended graph")
endif()
if(NOT FOUNDATION_APPENDED_KERNEL_MAINTENANCE)
  message(FATAL_ERROR "Rich appended production requires explicit kernel maintenance")
endif()
if(NOT FOUNDATION_BUILD_GUI)
  message(FATAL_ERROR "Rich appended production requires the browser GUI composition")
endif()
if(NOT EMSCRIPTEN OR NOT CMAKE_SIZEOF_VOID_P EQUAL 4)
  message(FATAL_ERROR "The rich browser graph requires the Emscripten wasm32 host; native document production uses its separate verified graph")
endif()
if(FOUNDATION_APPENDED_ENGINE_NATIVE_DOCUMENT_PROFILE)
  message(FATAL_ERROR "A native document profile cannot enter the rich browser graph")
endif()
if(FOUNDATION_APPENDED_ENGINE_DOCUMENT_PROFILE STREQUAL "editor")
  if(NOT FOUNDATION_APPENDED_ENGINE_EDITOR_CONSUMER_VERIFIED)
    message(FATAL_ERROR "The editor browser profile requires its separately verified editor retained-engine contract")
  endif()
elseif(FOUNDATION_APPENDED_ENGINE_DOCUMENT_PROFILE AND NOT FOUNDATION_APPENDED_ENGINE_DOCUMENT_CONSUMER_VERIFIED)
  message(FATAL_ERROR "The selected browser document profile requires its strict retained-engine verification")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/AppendedCommon.cmake")
if(FOUNDATION_APPENDED_PROFILE STREQUAL "both")
  include("${CMAKE_CURRENT_LIST_DIR}/AppendedBinary.cmake")
endif()
