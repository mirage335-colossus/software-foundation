if("@FOUNDATION_SANITIZERS@" OR "@FOUNDATION_BUILD_GUI@")
  message(FATAL_ERROR "Packaging requires a non-instrumented core build. Optional GUI distribution awaits dependency license review.")
endif()
if(NOT "@CMAKE_CONFIGURATION_TYPES@" STREQUAL "")
  if(NOT CPACK_BUILD_CONFIG STREQUAL "Release")
    message(FATAL_ERROR "Package a Release configuration")
  endif()
elseif(NOT "@CMAKE_BUILD_TYPE@" STREQUAL "Release")
  message(FATAL_ERROR "Reconfigure a Release tree before packaging")
endif()
