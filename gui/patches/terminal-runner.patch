+template<class Host> auto now(Host& host) {
+    if constexpr(requires {host.now();})return host.now();
+    else return std::chrono::steady_clock::now();
+}
+inline int wait_timeout(const RunnerState& state,std::chrono::steady_clock::time_point now,
+                        std::optional<std::chrono::steady_clock::time_point> close_deadline={}) {
+    auto until=now+std::chrono::milliseconds(30);
+    if(state.deadline)until=std::min(until,*state.deadline);
+    if(close_deadline)until=std::min(until,*close_deadline);
+    // A due deadline gets another ordinary tick after a bounded yield, never
+    // an unbounded callback/busy loop if a producer retains an expired value.
+    const auto delay=std::chrono::ceil<std::chrono::milliseconds>(until-now).count();
+    return static_cast<int>(std::clamp<std::int64_t>(delay,1,30));
+}
