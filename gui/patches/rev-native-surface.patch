+void Adapter::native_surface(std::shared_ptr<NativeSurfaceHooks> hooks,bool editor) {
+    policy().require_interaction();
+    if(!impl_->window)throw std::runtime_error("Rev native surface has no Window");
+    if(!hooks) {
+        impl_->window->window->suspendNativeSurface();
+        impl_->window->window->enableNativeSurface(false);
+        impl_->surface_hooks.reset();return;
+    }
+    if(!hooks->event || !hooks->lifecycle)throw std::invalid_argument("Incomplete Rev native surface hooks");
+    impl_->surface_hooks=std::move(hooks);
+    if(!impl_->window->window->enableNativeSurface(true,editor)) {
+        impl_->surface_hooks.reset();throw std::runtime_error("Rev native raw/editor frontend is unavailable");
+    }
+}
+void Adapter::native_surface_window(std::string title,int width,int height) {
+    policy().require_interaction();
+    if(!impl_->surface_hooks || !impl_->window || width<=0 || height<=0 || width>16384 || height>16384)
+        throw std::invalid_argument("Invalid or unstaged Rev native surface Window");
+    impl_->window->setTitle(title);
+    impl_->window->setSize(int(std::ceil(width*impl_->window->details.scale)),int(std::ceil(height*impl_->window->details.scale)));
+    const auto actual=impl_->window->window->getNativeSurfaceFacts();
+    if(actual.width<=0 || actual.height<=0 || actual.width>16384 || actual.height>16384)
+        throw std::runtime_error("Rev staging has no bounded actual client extent");
+    impl_->window->window->size.w=int(actual.width);impl_->window->window->size.h=int(actual.height);
+    // Window::setSize alone does not invalidate the retained GL canvas. Stage
+    // the actual extent now; a later OS notification may confirm or replace it.
+    impl_->window->Rev::Window::onResize(int(actual.width),int(actual.height));
+}
+RevSurfaceFacts Adapter::native_surface_facts() const {
+    (void)closed();
+    if(!impl_->window)return {};
+    return impl_->window->window->getNativeSurfaceFacts();
+}
+void Adapter::native_surface_context(const RevSurfaceContext& context) {
+    policy().require_interaction();
+    if(!impl_->surface_hooks || !impl_->window || !impl_->window->window->installNativeSurfaceContext(context))
+        throw std::runtime_error("Rev actual native frontend/caret rejected its bounded context");
+}
+void Adapter::native_surface_suspend(bool retire_pointer) {
+    if(retire_pointer)for(auto& button:impl_->surface_buttons)button.set(false);
+    if(impl_->window)impl_->window->window->suspendNativeSurface();
+}
+bool Adapter::native_surface_capture(bool capture) {
+    policy().require_interaction();
+    return impl_->window && impl_->window->window->captureNativeSurface(capture);
 }
 
