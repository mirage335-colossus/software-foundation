+inline constexpr std::size_t maximum_text_bytes=65536;
+inline bool append_scalar(std::string& out, std::uint32_t scalar) {
+    if (!scalar || scalar>0x10ffff || (scalar>=0xd800 && scalar<=0xdfff)) return false;
+    if (scalar<0x80) out.push_back(char(scalar));
+    else if (scalar<0x800) {
+        out.push_back(char(0xc0|(scalar>>6))); out.push_back(char(0x80|(scalar&63)));
+    } else if (scalar<0x10000) {
+        out.push_back(char(0xe0|(scalar>>12))); out.push_back(char(0x80|((scalar>>6)&63)));
+        out.push_back(char(0x80|(scalar&63)));
+    } else {
+        out.push_back(char(0xf0|(scalar>>18))); out.push_back(char(0x80|((scalar>>12)&63)));
+        out.push_back(char(0x80|((scalar>>6)&63))); out.push_back(char(0x80|(scalar&63)));
+    }
+    return out.size()<=maximum_text_bytes;
+}
+inline std::optional<std::u16string> utf16(std::string_view value) {
+    if (value.size()>maximum_text_bytes) return {};
+    std::u16string out;
+    for (std::size_t at=0;at<value.size();) {
+        const auto lead=static_cast<unsigned char>(value[at++]);
+        unsigned count=0;std::uint32_t scalar=lead,minimum=0;
+        if (lead>=0xc2 && lead<=0xdf) {count=1;scalar=lead&31;minimum=0x80;}
+        else if (lead>=0xe0 && lead<=0xef) {count=2;scalar=lead&15;minimum=0x800;}
+        else if (lead>=0xf0 && lead<=0xf4) {count=3;scalar=lead&7;minimum=0x10000;}
+        else if (lead>=0x80 || !lead) return {};
+        if (count>value.size()-at) return {};
+        for (unsigned n=0;n<count;++n) {
+            const auto next=static_cast<unsigned char>(value[at++]);
+            if ((next&0xc0)!=0x80) return {};
+            scalar=(scalar<<6)|(next&63);
+        }
+        if (scalar<minimum || scalar>0x10ffff || (scalar>=0xd800 && scalar<=0xdfff)) return {};
+        if (scalar<0x10000) out.push_back(char16_t(scalar));
+        else {scalar-=0x10000;out.push_back(char16_t(0xd800+(scalar>>10)));out.push_back(char16_t(0xdc00+(scalar&1023)));}
+    }
+    return out;
+}
+inline bool boundary(std::u16string_view value,std::size_t at) noexcept {
+    return at<=value.size() && (at==0 || at==value.size() ||
+        !(value[at]>=0xdc00 && value[at]<=0xdfff));
+}
+inline std::optional<std::string> utf8(std::u16string_view value) {
+    if (value.size()>maximum_text_bytes) return {};
+    std::string out;
+    for (std::size_t n=0;n<value.size();++n) {
+        std::uint32_t scalar=value[n];
+        if (scalar>=0xd800 && scalar<=0xdbff) {
+            if (++n>=value.size() || value[n]<0xdc00 || value[n]>0xdfff) return {};
+            scalar=0x10000+((scalar-0xd800)<<10)+(value[n]-0xdc00);
+        }
+        if (!append_scalar(out,scalar)) return {};
+    }
+    return out;
+}
