+    std::int32_t result{};
+    importing_ = true;
+    try {
+        result = import_(context_, op, request.data(), static_cast<std::uint32_t>(written), response.data(),
+            static_cast<std::uint32_t>(response.size()));
+    } catch (...) { fail("copied host import exception"); }
