# Finite Windows configuration of the SAME PORT=Foundation WebCore/JSC graph.
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    message(FATAL_ERROR "Windows engine cache cannot configure on another host")
endif()
set(PORT Foundation CACHE STRING "Common private engine port" FORCE)
set(CMAKE_TOOLCHAIN_FILE "@CMAKE_TOOLCHAIN_FILE@" CACHE FILEPATH "Pinned native toolchain" FORCE)
set(CMAKE_MAKE_PROGRAM "@CMAKE_MAKE_PROGRAM@" CACHE FILEPATH "Pinned Ninja" FORCE)
set(CMAKE_BUILD_TYPE Release CACHE STRING "Release candidate only" FORCE)
set(CMAKE_CXX_STANDARD 23 CACHE STRING "Private engine C++23 policy" FORCE)
set(CMAKE_CXX_STANDARD_REQUIRED ON CACHE BOOL "Require C++23" FORCE)
set(CMAKE_CXX_EXTENSIONS OFF CACHE BOOL "No language extensions" FORCE)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded CACHE STRING "Explicit /MT" FORCE)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Retain actual compile input evidence" FORCE)
set(Python_EXECUTABLE "@Python_EXECUTABLE@" CACHE FILEPATH "Complete retained Python runtime" FORCE)
set(PERL_EXECUTABLE "@PERL_EXECUTABLE@" CACHE FILEPATH "Complete retained Perl runtime" FORCE)
set(Ruby_EXECUTABLE "@Ruby_EXECUTABLE@" CACHE FILEPATH "Complete retained Ruby runtime" FORCE)
set(GPERF_EXECUTABLE "@GPERF_EXECUTABLE@" CACHE FILEPATH "Retained gperf" FORCE)
set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF CACHE BOOL "No user registry" FORCE)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF CACHE BOOL "No system registry" FORCE)
set(CMAKE_FIND_USE_SYSTEM_ENVIRONMENT_PATH OFF CACHE BOOL "No ambient package/tool discovery" FORCE)
set(ENABLE_TOOLS OFF CACHE BOOL "No supplier applications" FORCE)
set(ENABLE_API_TESTS OFF CACHE BOOL "No unrequested supplier tests" FORCE)
set(ENABLE_JAVASCRIPTCORE ON CACHE BOOL "Common actual JavaScript engine" FORCE)
set(ENABLE_WEBCORE ON CACHE BOOL "Common actual HTML engine" FORCE)
set(ENABLE_WEBKIT OFF CACHE BOOL "Direct private provider" FORCE)
set(ENABLE_WEBKIT_LEGACY OFF CACHE BOOL "Direct private provider" FORCE)
set(ENABLE_WEBINSPECTORUI OFF CACHE BOOL "No inspector UI" FORCE)
foreach(_enabled IN ITEMS ENABLE_STATIC_JSC ENABLE_C_LOOP USE_SYSTEM_MALLOC USE_SKIA USE_SKIA_CPU_ONLY USE_GENERIC_EVENT_LOOP)
    set(${_enabled} ON CACHE BOOL "Explicit CPU/CLoop profile" FORCE)
endforeach()
foreach(_disabled IN ITEMS ENABLE_JIT ENABLE_DFG_JIT ENABLE_FTL_JIT ENABLE_WEBASSEMBLY ENABLE_REMOTE_INSPECTOR ENABLE_WEBGL ENABLE_WEBGPU USE_WINDOWS_EVENT_LOOP WTF_DEFAULT_EVENT_LOOP)
    set(${_disabled} OFF CACHE BOOL "Explicit CPU/CLoop exclusion" FORCE)
endforeach()
set(FOUNDATION_NATIVE_DEPENDENCY_TARGET windows-x86_64 CACHE STRING "Admitted target" FORCE)
set(BIB_NATIVE_PROVIDER_DEPENDENCY_TARGET windows-x86_64 CACHE STRING "Same target" FORCE)
set(FOUNDATION_NATIVE_DEPENDENCY_PREFIX "@FOUNDATION_NATIVE_DEPENDENCY_PREFIX@" CACHE PATH "Admitted native prefix" FORCE)
set(BIB_NATIVE_PROVIDER_DEPENDENCY_PREFIX "@FOUNDATION_NATIVE_DEPENDENCY_PREFIX@" CACHE PATH "Same prefix" FORCE)
set(FOUNDATION_NATIVE_WINDOWS_INPUTS "@FOUNDATION_NATIVE_WINDOWS_INPUTS@" CACHE FILEPATH "Exact unmodified handoff native inputs" FORCE)
set(FOUNDATION_NATIVE_WINDOWS_INPUTS_SHA256 "@FOUNDATION_NATIVE_WINDOWS_INPUTS_SHA256@" CACHE STRING "Independent input manifest pin" FORCE)
set(BIB_NATIVE_PROVIDER_SOURCE_ROOT "@BIB_NATIVE_PROVIDER_SOURCE_ROOT@" CACHE PATH "Immutable assembled source tree" FORCE)
set(BIB_NATIVE_PROVIDER_BINDING_SOURCE "@BIB_NATIVE_PROVIDER_BINDING_SOURCE@" CACHE FILEPATH "Actual native actions binding" FORCE)
set(BIB_NATIVE_PROVIDER_BINDING_SOURCE_SHA256 "@BIB_NATIVE_PROVIDER_BINDING_SOURCE_SHA256@" CACHE STRING "Binding pin" FORCE)
set(BIB_NATIVE_PROVIDER_BINDING_HEADER "@BIB_NATIVE_PROVIDER_BINDING_HEADER@" CACHE FILEPATH "Actual native bootstrap header" FORCE)
set(BIB_NATIVE_PROVIDER_BINDING_HEADER_SHA256 "@BIB_NATIVE_PROVIDER_BINDING_HEADER_SHA256@" CACHE STRING "Bootstrap pin" FORCE)
set(BIB_NATIVE_PROVIDER_METADATA_HEADER "@BIB_NATIVE_PROVIDER_METADATA_HEADER@" CACHE FILEPATH "Transferred R/S/B-derived header" FORCE)
set(BIB_NATIVE_PROVIDER_METADATA_HEADER_SHA256 "@BIB_NATIVE_PROVIDER_METADATA_HEADER_SHA256@" CACHE STRING "Exact generated header pin" FORCE)
set(BIB_NATIVE_EMBEDDER_CMAKE "@BIB_NATIVE_EMBEDDER_CMAKE@" CACHE FILEPATH "Same retained common provider graph" FORCE)
