# Runs only as a post-link command inside the explicitly authorized candidate
# graph. It inspects bytes; it never loads the DSO or publishes an eligible SDK.
cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED BIB_NATIVE_PROTOTYPE_INSPECTION_KIND)
    set(BIB_NATIVE_PROTOTYPE_INSPECTION_KIND "provider-v1")
endif()
if(BIB_NATIVE_PROTOTYPE_INSPECTION_KIND STREQUAL "provider-v1")
    set(_expected_export "bib_engine_get_provider_v1")
    set(_inspection_kind "foundation-native-engine-prototype-inspection-v1")
    set(_inspection_scope "actual-linked-native-candidate-byte-inspection")
elseif(BIB_NATIVE_PROTOTYPE_INSPECTION_KIND STREQUAL "dependencies-pic-v1")
    set(_expected_export "foundation_native_dependency_pic_probe")
    set(_inspection_kind "foundation-native-dependencies-private-pic-inspection-v1")
    set(_inspection_scope "actual-linked-native-dependencies-private-pic-byte-inspection")
elseif(BIB_NATIVE_PROTOTYPE_INSPECTION_KIND STREQUAL "runtime-probe-v1")
    set(_expected_export "bib_native_runtime_probe_v1")
    set(_inspection_kind "foundation-native-private-runtime-probe-inspection-v1")
    set(_inspection_scope "actual-linked-native-private-runtime-probe-byte-inspection")
else()
    message(FATAL_ERROR "Unknown closed native private inspection kind")
endif()
foreach(_name IN ITEMS ARTIFACT BUILD_ROOT EVIDENCE INSPECT_TOOL INSPECT_SHA256
        ALLOWED_NEEDED_JSON MAXIMUM_ARTIFACT_BYTES PRIVATE_RUNTIME_POLICY_SHA256)
    if(NOT DEFINED BIB_NATIVE_PROTOTYPE_${_name})
        message(FATAL_ERROR "Missing explicit native prototype inspection input: ${_name}")
    endif()
endforeach()
if(NOT BIB_NATIVE_PROTOTYPE_PRIVATE_RUNTIME_POLICY_SHA256 STREQUAL
        "4983920c892241475f839f6bc6e7a293b348322e390307d4a1769b97ceab9bcc")
    message(FATAL_ERROR "Native provider inspection requires its explicit private-static runtime policy")
endif()
foreach(_name IN ITEMS ARTIFACT BUILD_ROOT EVIDENCE INSPECT_TOOL)
    set(_path "${BIB_NATIVE_PROTOTYPE_${_name}}")
    if(NOT IS_ABSOLUTE "${_path}" OR NOT EXISTS "${_path}" OR IS_SYMLINK "${_path}" OR
            "${_path}" MATCHES "[;\"\n\r]" OR "${_path}" MATCHES "\\$<")
        message(FATAL_ERROR "Native inspection requires an admitted ordinary absolute ${_name}")
    endif()
endforeach()
if(IS_DIRECTORY "${BIB_NATIVE_PROTOTYPE_ARTIFACT}" OR IS_DIRECTORY "${BIB_NATIVE_PROTOTYPE_INSPECT_TOOL}" OR
        NOT IS_DIRECTORY "${BIB_NATIVE_PROTOTYPE_BUILD_ROOT}" OR NOT IS_DIRECTORY "${BIB_NATIVE_PROTOTYPE_EVIDENCE}")
    message(FATAL_ERROR "Native inspection file/directory kinds differ")
endif()
file(REAL_PATH "${BIB_NATIVE_PROTOTYPE_BUILD_ROOT}" _root)
file(REAL_PATH "${BIB_NATIVE_PROTOTYPE_ARTIFACT}" _artifact)
file(REAL_PATH "${BIB_NATIVE_PROTOTYPE_EVIDENCE}" _evidence)
cmake_path(IS_PREFIX _root "${_artifact}" NORMALIZE _artifact_inside)
cmake_path(IS_PREFIX _root "${_evidence}" NORMALIZE _evidence_inside)
if(NOT _artifact_inside OR NOT _evidence_inside OR _root STREQUAL _evidence)
    message(FATAL_ERROR "Native inspection output escapes the private CMake tree")
endif()
file(SHA256 "${BIB_NATIVE_PROTOTYPE_INSPECT_TOOL}" _tool_sha)
if(NOT _tool_sha STREQUAL BIB_NATIVE_PROTOTYPE_INSPECT_SHA256)
    message(FATAL_ERROR "Native inspection tool changed from its independent pin")
endif()
if(NOT BIB_NATIVE_PROTOTYPE_MAXIMUM_ARTIFACT_BYTES MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Native artifact size limit is not a positive integer")
endif()
file(SIZE "${_artifact}" _bytes)
if(_bytes LESS 64 OR _bytes GREATER BIB_NATIVE_PROTOTYPE_MAXIMUM_ARTIFACT_BYTES)
    message(FATAL_ERROR "Native provider artifact exceeds its explicit size bound")
endif()
file(READ "${_artifact}" _header OFFSET 0 LIMIT 20 HEX)
string(SUBSTRING "${_header}" 0 14 _ident)
string(SUBSTRING "${_header}" 32 4 _type)
string(SUBSTRING "${_header}" 36 4 _machine)
if(NOT _ident STREQUAL "7f454c46020101" OR NOT _type STREQUAL "0300" OR NOT _machine STREQUAL "3e00")
    message(FATAL_ERROR "Native first prototype must be an actual little-endian ELF64 x86_64 shared object")
endif()
file(SHA256 "${_artifact}" _artifact_sha)
set(_symbols "${_evidence}/provider-dynamic-symbols.txt")
set(_dynamic "${_evidence}/provider-dynamic-section.txt")
set(_versions "${_evidence}/provider-version-info.txt")
set(_version_errors "${_evidence}/provider-version-info-stderr.txt")
set(_errors "${_evidence}/provider-inspection-stderr.txt")
set(_receipt "${_evidence}/provider-inspection.json")
foreach(_output IN ITEMS "${_symbols}" "${_dynamic}" "${_versions}"
        "${_version_errors}" "${_errors}" "${_receipt}")
    if(EXISTS "${_output}" OR IS_SYMLINK "${_output}")
        message(FATAL_ERROR "Native inspection refuses to overwrite prior evidence: ${_output}")
    endif()
endforeach()
execute_process(COMMAND "${BIB_NATIVE_PROTOTYPE_INSPECT_TOOL}" --dyn-syms --wide "${_artifact}"
    OUTPUT_FILE "${_symbols}" ERROR_FILE "${_errors}" RESULT_VARIABLE _result TIMEOUT 30)
if(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Actual native dynamic-symbol inspection failed: ${_result}")
endif()
execute_process(COMMAND "${BIB_NATIVE_PROTOTYPE_INSPECT_TOOL}" --dynamic --wide "${_artifact}"
    OUTPUT_FILE "${_dynamic}" ERROR_VARIABLE _dynamic_error RESULT_VARIABLE _result TIMEOUT 30)
file(APPEND "${_errors}" "${_dynamic_error}")
if(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Actual native dynamic-section inspection failed: ${_result}")
endif()
execute_process(COMMAND "${BIB_NATIVE_PROTOTYPE_INSPECT_TOOL}" --version-info --wide "${_artifact}"
    OUTPUT_FILE "${_versions}" ERROR_FILE "${_version_errors}" RESULT_VARIABLE _result TIMEOUT 30)
if(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Actual native version-info inspection failed: ${_result}")
endif()
foreach(_output IN ITEMS "${_symbols}" "${_dynamic}" "${_versions}" "${_version_errors}" "${_errors}")
    file(SIZE "${_output}" _output_bytes)
    if(_output_bytes GREATER 4194304)
        message(FATAL_ERROR "Native inspection output exceeds its 4 MiB per-file bound")
    endif()
endforeach()
# Only GNU version-needs records associate imported version indices with their
# providers. A similarly named version definition in this DSO proves no such
# association. Keep the provider/name/index map distinct from both other tables.
file(READ "${_versions}" _version_text)
if(_version_text MATCHES "[;\r]")
    message(FATAL_ERROR "Native version-info stream contains unsupported record separators")
endif()
string(REPLACE "\n" ";" _version_lines "${_version_text}")
set(_needs_seen FALSE)
set(_needs_active FALSE)
set(_needs_providers)
set(_need_indices)
set(_needs_provider "")
set(_needs_provider_count 0)
set(_needs_provider_seen 0)
set(_needs_expected_providers 0)
set(_needs_address_seen FALSE)
foreach(_version_line IN LISTS _version_lines)
    string(STRIP "${_version_line}" _version_line)
    if(_version_line MATCHES "^Version needs section ")
        if(_needs_seen OR NOT _version_line MATCHES "^Version needs section '[^']+' contains ([1-9][0-9]*) entr(y|ies):$")
            message(FATAL_ERROR "Native version-needs section is duplicated or malformed")
        endif()
        set(_needs_expected_providers "${CMAKE_MATCH_1}")
        string(LENGTH "${_needs_expected_providers}" _count_digits)
        if(_count_digits GREATER 2 OR _needs_expected_providers GREATER 32)
            message(FATAL_ERROR "Native version-needs provider count exceeds its explicit bound")
        endif()
        set(_needs_seen TRUE)
        set(_needs_active TRUE)
    elseif(_version_line MATCHES "^Version .* section ")
        set(_needs_active FALSE)
    elseif(_needs_active AND NOT _version_line STREQUAL "")
        if(_version_line MATCHES "^(0x[0-9a-fA-F]+|[0-9a-fA-F]+):[ \t]+Version:[ \t]+1[ \t]+File:[ \t]+([A-Za-z0-9_+.-]+)[ \t]+Cnt:[ \t]+([1-9][0-9]*)$")
            set(_next_provider "${CMAKE_MATCH_2}")
            set(_next_count "${CMAKE_MATCH_3}")
            string(LENGTH "${_next_count}" _count_digits)
            if(_count_digits GREATER 5 OR _next_count GREATER 32766)
                message(FATAL_ERROR "Native version-needs entry count exceeds its explicit bound")
            endif()
            if(NOT _needs_provider STREQUAL "" AND NOT _needs_provider_seen EQUAL _needs_provider_count)
                message(FATAL_ERROR "Native version-needs provider entry count is contradictory")
            endif()
            if(_next_provider IN_LIST _needs_providers)
                message(FATAL_ERROR "Native version-needs repeats a provider: ${_next_provider}")
            endif()
            list(APPEND _needs_providers "${_next_provider}")
            list(LENGTH _needs_providers _provider_count)
            if(_provider_count GREATER _needs_expected_providers)
                message(FATAL_ERROR "Native version-needs has more providers than declared")
            endif()
            set(_needs_provider "${_next_provider}")
            set(_needs_provider_count "${_next_count}")
            set(_needs_provider_seen 0)
        elseif(_version_line MATCHES "^(0x[0-9a-fA-F]+|[0-9a-fA-F]+):[ \t]+Name:[ \t]+([A-Za-z0-9_.+-]+)[ \t]+Flags:[ \t]+(none|WEAK)[ \t]+Version:[ \t]+([1-9][0-9]*)$")
            set(_need_name "${CMAKE_MATCH_2}")
            set(_need_index "${CMAKE_MATCH_4}")
            string(LENGTH "${_need_index}" _index_digits)
            if(_needs_provider STREQUAL "" OR _index_digits GREATER 5 OR
                    _need_index LESS 2 OR _need_index GREATER 32767)
                message(FATAL_ERROR "Native version-needs entry has no provider or an invalid version index")
            endif()
            if(_need_index IN_LIST _need_indices)
                message(FATAL_ERROR "Native version-needs repeats or contradicts an imported version index: ${_need_index}")
            endif()
            list(APPEND _need_indices "${_need_index}")
            set(_need_provider_${_need_index} "${_needs_provider}")
            set(_need_name_${_need_index} "${_need_name}")
            math(EXPR _needs_provider_seen "${_needs_provider_seen} + 1")
            if(_needs_provider_seen GREATER _needs_provider_count)
                message(FATAL_ERROR "Native version-needs provider has more entries than declared")
            endif()
        elseif(_version_line MATCHES "^Addr:[ \t]+0x[0-9a-fA-F]+[ \t]+Offset:[ \t]+0x[0-9a-fA-F]+[ \t]+Link:[ \t]+[0-9]+[ \t]+\\([^()]+\\)$")
            if(_needs_address_seen OR NOT _needs_provider STREQUAL "")
                message(FATAL_ERROR "Native version-needs address metadata is duplicated or misplaced")
            endif()
            set(_needs_address_seen TRUE)
        else()
            message(FATAL_ERROR "Native version-needs contains a malformed provider/name/index record: ${_version_line}")
        endif()
    endif()
endforeach()
if(_needs_seen)
    list(LENGTH _needs_providers _provider_count)
    if(NOT _provider_count EQUAL _needs_expected_providers OR
            NOT _needs_provider_seen EQUAL _needs_provider_count)
        message(FATAL_ERROR "Native version-needs provider/name counts differ from their declarations")
    endif()
endif()
file(READ "${_symbols}" _symbol_text)
string(REPLACE "\n" ";" _symbol_lines "${_symbol_text}")
set(_exports)
set(_libc_abi_exceptions_seen FALSE)
foreach(_line IN LISTS _symbol_lines)
    if(_line MATCHES "^[ \t]*[0-9]+:[ \t]+[0-9a-fA-F]+[ \t]+[0-9]+[ \t]+([^ \t]+)[ \t]+(GLOBAL|WEAK|UNIQUE)[ \t]+(DEFAULT|PROTECTED)[ \t]+([^ \t]+)[ \t]+([^ \t]+)(.*)$")
        set(_section "${CMAKE_MATCH_4}")
        set(_symbol "${CMAKE_MATCH_5}")
        set(_symbol_type "${CMAKE_MATCH_1}")
        set(_symbol_binding "${CMAKE_MATCH_2}")
        set(_symbol_visibility "${CMAKE_MATCH_3}")
        set(_symbol_suffix "${CMAKE_MATCH_6}")
        if(_section STREQUAL "UND")
            if(_symbol MATCHES "@+(GLIBCXX_|CXXABI_|GCC_)")
                message(FATAL_ERROR "Private native provider retains an unresolved versioned C++/unwind import: ${_symbol}")
            endif()
            string(REGEX REPLACE "@.*$" "" _base "${_symbol}")
            # These C ABI functions belong to glibc, not libstdc++/libgcc. They
            # are permitted only with an actual bounded GLIBC version import.
            set(_libc_cxx_abi __cxa_atexit __cxa_finalize __cxa_thread_atexit_impl)
            if(_base MATCHES "^(_Z|_Unwind_|__gxx_|__gcc_|__cxa_|__register_frame|__deregister_frame|__dynamic_cast)")
                if(NOT _base IN_LIST _libc_cxx_abi OR NOT _symbol MATCHES "@+GLIBC_([0-9]+([.][0-9]+)*)$")
                    message(FATAL_ERROR "Private native provider retains an unresolved C++/unwind import: ${_symbol}")
                endif()
                string(REGEX REPLACE "^.*@" "" _required_version "${_symbol}")
                if(NOT _symbol_suffix MATCHES "^[ \t]+\\(([1-9][0-9]*)\\)[ \t]*$")
                    message(FATAL_ERROR "Native libc ABI exception lacks an explicit imported version index: ${_symbol}")
                endif()
                set(_required_index "${CMAKE_MATCH_1}")
                string(LENGTH "${_required_index}" _index_digits)
                if(_index_digits GREATER 5 OR _required_index LESS 2 OR _required_index GREATER 32767)
                    message(FATAL_ERROR "Native libc ABI exception has an invalid imported version index: ${_symbol}")
                endif()
                if(NOT _required_index IN_LIST _need_indices OR
                        NOT _need_provider_${_required_index} STREQUAL "libc.so.6" OR
                        NOT _need_name_${_required_index} STREQUAL _required_version)
                    message(FATAL_ERROR "Native libc ABI exception lacks a matching libc.so.6 version-needs provider/name/index: ${_symbol}")
                endif()
                set(_libc_abi_exceptions_seen TRUE)
            endif()
            if(_symbol MATCHES "@+GLIBC_([0-9]+([.][0-9]+)*)$")
                if(CMAKE_MATCH_1 VERSION_GREATER "2.36")
                    message(FATAL_ERROR "Native provider imports a GLIBC version above2.36: ${_symbol}")
                endif()
            elseif(_symbol MATCHES "@+GLIBC_")
                message(FATAL_ERROR "Native provider has an unsupported GLIBC version import: ${_symbol}")
            endif()
        else()
            if(_symbol STREQUAL _expected_export AND
                    (NOT _symbol_type STREQUAL "FUNC" OR NOT _symbol_binding STREQUAL "GLOBAL" OR
                     NOT _symbol_visibility STREQUAL "DEFAULT"))
                message(FATAL_ERROR "Native getter must be an ordinary GLOBAL DEFAULT FUNC; data, weak and resolver exports are invalid")
            endif()
            list(APPEND _exports "${_symbol}")
        endif()
    endif()
endforeach()
if(NOT "${_exports}" STREQUAL _expected_export)
    message(FATAL_ERROR "Native provider must define exactly the one public getter; actual exports: ${_exports}")
endif()
file(READ "${_dynamic}" _dynamic_text)
if(_dynamic_text MATCHES "TEXTREL")
    message(FATAL_ERROR "Native provider contains dynamic text relocations; static dependencies were not an admitted PIC closure")
endif()
string(JSON _allowed_count ERROR_VARIABLE _json_error LENGTH "${BIB_NATIVE_PROTOTYPE_ALLOWED_NEEDED_JSON}")
if(_json_error OR _allowed_count LESS 1 OR _allowed_count GREATER 32)
    message(FATAL_ERROR "Native runtime library allowlist must be a bounded explicit nonempty JSON array")
endif()
set(_allowed)
math(EXPR _last "${_allowed_count} - 1")
foreach(_index RANGE 0 ${_last})
    string(JSON _item ERROR_VARIABLE _json_error GET "${BIB_NATIVE_PROTOTYPE_ALLOWED_NEEDED_JSON}" ${_index})
    if(_json_error OR NOT _item MATCHES "^lib[A-Za-z0-9_+.-]+\\.so(\\.[0-9]+)*$")
        message(FATAL_ERROR "Native runtime library allowlist contains an unsupported entry")
    endif()
    list(APPEND _allowed "${_item}")
endforeach()
string(REPLACE "\n" ";" _dynamic_lines "${_dynamic_text}")
set(_needed)
foreach(_line IN LISTS _dynamic_lines)
    if(_line MATCHES "\\(NEEDED\\).*\\[([^]]+)\\]")
        set(_name "${CMAKE_MATCH_1}")
        if(_name MATCHES "^lib(stdc[+][+]|supc[+][+]|gcc_s|c[+][+](abi)?|unwind)[.]so([.][0-9]+)*$")
            message(FATAL_ERROR "Private native provider selected a shared C++/unwind runtime: ${_name}")
        endif()
        if(NOT _name IN_LIST _allowed)
            message(FATAL_ERROR "Native provider has an undeclared actual dynamic dependency: ${_name}")
        endif()
        list(APPEND _needed "${_name}")
    elseif(_line MATCHES "\\((RPATH|RUNPATH)\\).*\\[([^]]+)\\]")
        if(NOT CMAKE_MATCH_2 STREQUAL "$ORIGIN")
            message(FATAL_ERROR "Native provider runtime search path differs from the private origin policy")
        endif()
    endif()
endforeach()
if(NOT _needed)
    message(FATAL_ERROR "Native provider has no observed runtime dependency entries; preserve the actual inspection instead of inferring a static-runtime pass")
endif()
if(_libc_abi_exceptions_seen AND NOT "libc.so.6" IN_LIST _needed)
    message(FATAL_ERROR "Native libc ABI exception version-needs provider lacks an actual libc.so.6 DT_NEEDED entry")
endif()
set(_needed_json "[]")
set(_index 0)
foreach(_name IN LISTS _needed)
    string(JSON _needed_json SET "${_needed_json}" ${_index} "\"${_name}\"")
    math(EXPR _index "${_index} + 1")
endforeach()
file(SHA256 "${_symbols}" _symbols_sha)
file(SHA256 "${_dynamic}" _dynamic_sha)
file(SHA256 "${_versions}" _versions_sha)
file(SHA256 "${_artifact}" _after_sha)
file(SHA256 "${BIB_NATIVE_PROTOTYPE_INSPECT_TOOL}" _after_tool_sha)
if(NOT _after_sha STREQUAL _artifact_sha OR NOT _after_tool_sha STREQUAL _tool_sha)
    message(FATAL_ERROR "Native artifact/inspection tool changed during actual inspection")
endif()
file(WRITE "${_receipt}" "{\n  \"schema_version\": 1,\n  \"kind\": \"${_inspection_kind}\",\n  \"scope\": \"${_inspection_scope}\",\n  \"artifact_sha256\": \"${_artifact_sha}\",\n  \"artifact_bytes\": ${_bytes},\n  \"architecture\": \"elf64-x86_64\",\n  \"exports\": [\"${_expected_export}\"],\n  \"needed\": ${_needed_json},\n  \"symbols_sha256\": \"${_symbols_sha}\",\n  \"dynamic_sha256\": \"${_dynamic_sha}\",\n  \"version_info_sha256\": \"${_versions_sha}\",\n  \"inspect_tool_sha256\": \"${_tool_sha}\",\n  \"private_runtime_policy_sha256\": \"${BIB_NATIVE_PROTOTYPE_PRIVATE_RUNTIME_POLICY_SHA256}\",\n  \"production_eligible\": false,\n  \"engine_execution\": false,\n  \"kernel_rebuild\": false\n}\n")
