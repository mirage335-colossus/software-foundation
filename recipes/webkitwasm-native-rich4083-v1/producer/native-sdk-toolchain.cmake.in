# Producer-owned native SDK adapter. No external helper or tool discovery.
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Native SDK adapter requires Linux host")
endif()
set(_foundation_native_sdk_root "@SDK_ROOT@")
file(SHA256 "${_foundation_native_sdk_root}/sdk.json" _foundation_native_sdk_manifest)
if(NOT _foundation_native_sdk_manifest STREQUAL "@SDK_MANIFEST_SHA256@")
    message(FATAL_ERROR "Original native SDK manifest changed")
endif()
set(_foundation_native_tool_C "@C@")
set(_foundation_native_tool_CXX "@CXX@")
set(_foundation_native_tool_LINKER "@LINKER@")
set(_foundation_native_tool_ARCHIVER "@ARCHIVER@")
set(_foundation_native_tool_RANLIB "@RANLIB@")
set(_foundation_native_tool_INSPECT "@INSPECT@")
set(_foundation_native_tool_CMAKE "@CMAKE@")
set(_foundation_native_tool_NINJA "@NINJA@")
set(_foundation_native_tool_PKG_CONFIG "@PKG_CONFIG@")
set(_foundation_native_hash_C "@C_SHA256@")
set(_foundation_native_hash_CXX "@CXX_SHA256@")
set(_foundation_native_hash_LINKER "@LINKER_SHA256@")
set(_foundation_native_hash_ARCHIVER "@ARCHIVER_SHA256@")
set(_foundation_native_hash_RANLIB "@RANLIB_SHA256@")
set(_foundation_native_hash_INSPECT "@INSPECT_SHA256@")
set(_foundation_native_hash_CMAKE "@CMAKE_SHA256@")
set(_foundation_native_hash_NINJA "@NINJA_SHA256@")
set(_foundation_native_hash_PKG_CONFIG "@PKG_CONFIG_SHA256@")
foreach(_role IN ITEMS C CXX LINKER ARCHIVER RANLIB INSPECT CMAKE NINJA PKG_CONFIG)
    file(SHA256 "${_foundation_native_tool_${_role}}" _actual_hash)
    if(NOT _actual_hash STREQUAL "${_foundation_native_hash_${_role}}")
        message(FATAL_ERROR "Admitted native SDK tool bytes changed")
    endif()
endforeach()
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER "@C@" CACHE FILEPATH "Admitted SDK C compiler" FORCE)
set(CMAKE_CXX_COMPILER "@CXX@" CACHE FILEPATH "Admitted SDK C++ compiler" FORCE)
set(CMAKE_LINKER "@LINKER@" CACHE FILEPATH "Admitted SDK linker" FORCE)
set(CMAKE_AR "@ARCHIVER@" CACHE FILEPATH "Admitted SDK archiver" FORCE)
set(CMAKE_RANLIB "@RANLIB@" CACHE FILEPATH "Admitted SDK ranlib" FORCE)
set(CMAKE_MAKE_PROGRAM "@NINJA@" CACHE FILEPATH "Admitted SDK Ninja" FORCE)
set(PKG_CONFIG_EXECUTABLE "@PKG_CONFIG@" CACHE FILEPATH "Admitted SDK pkg-config" FORCE)
set(FOUNDATION_NATIVE_INSPECT_EXECUTABLE "@INSPECT@" CACHE FILEPATH "Admitted SDK ELF inspector" FORCE)
set(FOUNDATION_NATIVE_CMAKE_EXECUTABLE "@CMAKE@" CACHE FILEPATH "Admitted SDK CMake" FORCE)
set(CMAKE_SYSROOT "@SDK_SYSROOT@")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_USE_SYSTEM_ENVIRONMENT_PATH OFF)
set(CMAKE_C_FLAGS_INIT "-march=x86-64 -mtune=generic")
set(CMAKE_CXX_FLAGS_INIT "-march=x86-64 -mtune=generic")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "@PKG_CONFIG_LIBDIR@")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_LINKER CMAKE_AR CMAKE_RANLIB CMAKE_MAKE_PROGRAM CMAKE_SYSROOT)
