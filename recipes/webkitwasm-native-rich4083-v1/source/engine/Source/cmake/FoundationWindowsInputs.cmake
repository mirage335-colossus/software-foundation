# Private native-engine Windows input admission. No find_package/pkg-config,
# source download, dependency preparation, compiler launch or build fallback.
# The explicit producer must verify retained inventories/provenance before
# configuring. Hash/target consistency here is not Windows qualification.
include_guard(GLOBAL)

function(_foundation_windows_keys document)
    string(JSON _count ERROR_VARIABLE _error LENGTH "${document}")
    list(LENGTH ARGN _expected)
    if(_error OR NOT _count EQUAL _expected)
        message(FATAL_ERROR "Windows native input object has an unsupported field set")
    endif()
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE 0 ${_last})
            string(JSON _key ERROR_VARIABLE _error MEMBER "${document}" ${_index})
            if(_error OR NOT _key IN_LIST ARGN)
                message(FATAL_ERROR "Windows native input object has an unknown field")
            endif()
        endforeach()
    endif()
endfunction()

function(_foundation_windows_json out document)
    string(JSON _value ERROR_VARIABLE _error GET "${document}" ${ARGN})
    if(_error)
        message(FATAL_ERROR "Missing or malformed retained Windows input field: ${ARGN}")
    endif()
    set(${out} "${_value}" PARENT_SCOPE)
endfunction()

function(_foundation_windows_pin path sha label)
    string(LENGTH "${sha}" _length)
    if(NOT _length EQUAL 64 OR NOT sha MATCHES "^[0-9a-f]+$" OR sha MATCHES "^0+$" OR
            NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}" OR
            IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}" OR
            "${path}" MATCHES "[;\"\n\r]" OR "${path}" MATCHES "\\$<")
        message(FATAL_ERROR "Retained Windows engine ${label} needs a pinned absolute ordinary file")
    endif()
    file(SHA256 "${path}" _actual)
    if(NOT _actual STREQUAL sha)
        message(FATAL_ERROR "Retained Windows engine ${label} differs from its independent SHA256")
    endif()
    # A later explicit incremental engine build must re-admit changed pinned
    # inputs, rather than silently link a mutated retained library/tool record.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
endfunction()

function(_foundation_windows_object_file out document label)
    _foundation_windows_json(_path "${document}" ${ARGN} path)
    _foundation_windows_json(_sha "${document}" ${ARGN} sha256)
    _foundation_windows_pin("${_path}" "${_sha}" "${label}")
    file(REAL_PATH "${_path}" _real)
    set(${out} "${_real}" PARENT_SCOPE)
endfunction()

function(foundation_import_windows_inputs)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Windows" OR NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows" OR
            NOT MSVC OR NOT COMPILER_IS_CLANG_CL OR NOT CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC" OR
            NOT WTF_CPU_X86_64 OR WTF_CPU_ARM64 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR EMSCRIPTEN)
        message(FATAL_ERROR "Windows engine inputs require native Windows x64 clang-cl; no MinGW, cross-host or Wasm fallback")
    endif()
    if(NOT CMAKE_CXX_STANDARD EQUAL 23 OR NOT CMAKE_BUILD_TYPE STREQUAL "Release" OR
            NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded")
        message(FATAL_ERROR "Initial optional Windows engine requires C++23 Release and explicit static /MT CRT; ordinary Foundation policy is unchanged")
    endif()
    foreach(_environment IN ITEMS CL _CL_ LINK _LINK_)
        if(NOT "$ENV{${_environment}}" STREQUAL "")
            message(FATAL_ERROR "Clear ambient Windows compiler/linker flag injection before explicit engine maintenance")
        endif()
    endforeach()
    foreach(_language IN ITEMS C CXX)
        foreach(_suffix IN ITEMS "" _RELEASE _DEBUG _RELWITHDEBINFO _MINSIZEREL)
            if("${CMAKE_${_language}_FLAGS${_suffix}}" MATCHES "(^|[ ;])/MDd?($|[ ;])" OR
                    "${CMAKE_${_language}_FLAGS${_suffix}}" MATCHES "(/arch:AVX|-march=|-mcpu=|-mavx|-mfma|-mf16c)")
                message(FATAL_ERROR "Windows engine forbids dynamic CRT or a global CPU-floor increase; optimized source leaves remain separately dispatched")
            endif()
        endforeach()
    endforeach()
    if(NOT EXISTS "${FOUNDATION_NATIVE_WINDOWS_INPUTS}" OR IS_DIRECTORY "${FOUNDATION_NATIVE_WINDOWS_INPUTS}")
        message(FATAL_ERROR "Windows native engine needs its explicit retained input manifest")
    endif()
    file(SIZE "${FOUNDATION_NATIVE_WINDOWS_INPUTS}" _bytes)
    if(_bytes GREATER 1048576)
        message(FATAL_ERROR "Windows native-engine input manifest exceeds 1 MiB")
    endif()
    _foundation_windows_pin("${FOUNDATION_NATIVE_WINDOWS_INPUTS}" "${FOUNDATION_NATIVE_WINDOWS_INPUTS_SHA256}" "input manifest")
    file(READ "${FOUNDATION_NATIVE_WINDOWS_INPUTS}" _document)
    _foundation_windows_keys("${_document}" schema_version kind target build_type crt cpu_baseline
        os_floor_declaration engine_cxx_standard dependency_prefix toolchain dependency_inventory woff2 libraries)
    foreach(_field IN ITEMS schema_version engine_cxx_standard)
        string(JSON _type TYPE "${_document}" ${_field})
        if(NOT _type STREQUAL "NUMBER")
            message(FATAL_ERROR "Windows native schema/standard must be JSON numbers")
        endif()
    endforeach()
    foreach(_field IN ITEMS kind target build_type crt cpu_baseline os_floor_declaration woff2)
        string(JSON _type TYPE "${_document}" ${_field})
        if(NOT _type STREQUAL "STRING")
            message(FATAL_ERROR "Windows native policy fields must be JSON strings")
        endif()
    endforeach()
    _foundation_windows_json(_toolchain "${_document}" toolchain)
    _foundation_windows_keys("${_toolchain}" compiler linker builtins compiler_version msvc_stl windows_sdk)
    foreach(_field IN ITEMS kind target build_type crt cpu_baseline os_floor_declaration)
        _foundation_windows_json(_${_field} "${_document}" ${_field})
    endforeach()
    _foundation_windows_json(_schema "${_document}" schema_version)
    _foundation_windows_json(_standard "${_document}" engine_cxx_standard)
    if(NOT _schema STREQUAL "1" OR NOT _standard STREQUAL "23" OR
            NOT _kind STREQUAL "foundation-native-engine-windows-inputs" OR
            NOT _target STREQUAL "windows-x86_64" OR NOT _build_type STREQUAL "Release" OR
            NOT _crt STREQUAL "static-mt" OR NOT _cpu_baseline STREQUAL "x86_64-sse2" OR
            NOT _os_floor_declaration STREQUAL "windows-10-1809-unqualified")
        message(FATAL_ERROR "Windows native-engine manifest target/toolchain/floor declaration differs; no qualification is inferred")
    endif()
    _foundation_windows_json(_prefix "${_document}" dependency_prefix)
    if(NOT IS_ABSOLUTE "${_prefix}" OR NOT IS_DIRECTORY "${_prefix}" OR IS_SYMLINK "${_prefix}" OR
            "${_prefix}" MATCHES "[;\"\n\r]" OR "${_prefix}" MATCHES "\\$<")
        message(FATAL_ERROR "Windows native dependencies need an explicit ordinary prefix")
    endif()
    file(REAL_PATH "${_prefix}" _prefix)
    file(REAL_PATH "${FOUNDATION_NATIVE_DEPENDENCY_PREFIX}" _selected_prefix)
    if(NOT _prefix STREQUAL _selected_prefix OR NOT FOUNDATION_NATIVE_DEPENDENCY_TARGET STREQUAL "windows-x86_64")
        message(FATAL_ERROR "Windows manifest and port dependency prefix/target disagree")
    endif()
    foreach(_tool IN ITEMS compiler linker builtins)
        _foundation_windows_json(_tool_record "${_document}" toolchain ${_tool})
        _foundation_windows_keys("${_tool_record}" path sha256)
        _foundation_windows_object_file(_${_tool} "${_document}" "${_tool}" toolchain ${_tool})
    endforeach()
    file(REAL_PATH "${CMAKE_CXX_COMPILER}" _selected_compiler)
    file(REAL_PATH "${CMAKE_C_COMPILER}" _selected_c_compiler)
    file(REAL_PATH "${CMAKE_LINKER}" _selected_linker)
    _foundation_windows_json(_compiler_version "${_document}" toolchain compiler_version)
    if(NOT _compiler STREQUAL _selected_compiler OR NOT _compiler STREQUAL _selected_c_compiler OR
            NOT _linker STREQUAL _selected_linker OR
            NOT _compiler_version STREQUAL CMAKE_CXX_COMPILER_VERSION)
        message(FATAL_ERROR "Windows selected compiler/linker/version differs from retained inputs")
    endif()
    foreach(_sdk IN ITEMS msvc_stl windows_sdk)
        _foundation_windows_json(_sdk_record "${_document}" toolchain ${_sdk})
        _foundation_windows_keys("${_sdk_record}" root inventory)
        _foundation_windows_json(_sdk_root "${_document}" toolchain ${_sdk} root)
        if(NOT IS_ABSOLUTE "${_sdk_root}" OR NOT IS_DIRECTORY "${_sdk_root}" OR IS_SYMLINK "${_sdk_root}" OR
                "${_sdk_root}" MATCHES "[;\"\n\r]" OR "${_sdk_root}" MATCHES "\\$<")
            message(FATAL_ERROR "Windows ${_sdk} needs its separately retained host root")
        endif()
        _foundation_windows_object_file(_inventory "${_document}" "${_sdk} inventory" toolchain ${_sdk} inventory)
        # The explicit producer verifies the complete declared SDK/STL contents;
        # this stage binds its independently retained inventory, not a scan.
    endforeach()
    _foundation_windows_object_file(_dependency_inventory "${_document}" "native dependency inventory" dependency_inventory)
    _foundation_windows_json(_woff2 "${_document}" woff2)
    if(NOT _woff2 STREQUAL "ON" AND NOT _woff2 STREQUAL "OFF")
        message(FATAL_ERROR "Windows manifest must explicitly select WOFF2 ON or OFF")
    endif()
    set(_required ICU::data ICU::i18n ICU::uc HarfBuzz::HarfBuzz HarfBuzz::ICU
        JPEG::JPEG LibXml2::LibXml2 PNG::PNG SQLite3::SQLite3 WebP::libwebp WebP::demux WebP::sharpyuv
        ZLIB::ZLIB CURL::libcurl OpenSSL::SSL OpenSSL::Crypto LibPSL::LibPSL
        FoundationNative::nghttp2 Brotli::dec Brotli::common)
    if(_woff2 STREQUAL "ON")
        list(APPEND _required WOFF2::dec WOFF2::common)
    endif()
    string(JSON _count ERROR_VARIABLE _error LENGTH "${_document}" libraries)
    list(LENGTH _required _expected_count)
    if(_error OR NOT _count EQUAL _expected_count)
        message(FATAL_ERROR "Windows native library map must contain exactly the selected closed target set")
    endif()
    foreach(_target IN LISTS _required)
        if(TARGET "${_target}")
            message(FATAL_ERROR "Windows native target already exists outside the admitted manifest: ${_target}")
        endif()
        _foundation_windows_json(_library_record "${_document}" libraries "${_target}")
        _foundation_windows_keys("${_library_record}" path sha256 includes definitions links)
        _foundation_windows_object_file(_library "${_document}" "${_target}" libraries "${_target}")
        cmake_path(IS_PREFIX _prefix "${_library}" NORMALIZE _inside)
        if(NOT _inside)
            message(FATAL_ERROR "Windows native library escapes its admitted prefix: ${_target}")
        endif()
        add_library("${_target}" STATIC IMPORTED GLOBAL)
        set_target_properties("${_target}" PROPERTIES IMPORTED_LOCATION "${_library}")
        foreach(_property IN ITEMS includes definitions links)
            string(JSON _items ERROR_VARIABLE _error LENGTH "${_document}" libraries "${_target}" ${_property})
            if(_error OR _items GREATER 128)
                message(FATAL_ERROR "Invalid bounded Windows native target property: ${_target}/${_property}")
            endif()
            set(_values)
            if(_items GREATER 0)
                math(EXPR _last "${_items} - 1")
                foreach(_index RANGE 0 ${_last})
                    _foundation_windows_json(_value "${_document}" libraries "${_target}" ${_property} ${_index})
                    if("${_value}" MATCHES "[;\"\n\r]" OR "${_value}" MATCHES "\\$<")
                        message(FATAL_ERROR "Windows native target property contains executable/list syntax")
                    endif()
                    if(_property STREQUAL "includes")
                        if(NOT IS_ABSOLUTE "${_value}" OR NOT IS_DIRECTORY "${_value}" OR IS_SYMLINK "${_value}")
                            message(FATAL_ERROR "Windows native target include must be a retained ordinary directory")
                        endif()
                        file(REAL_PATH "${_value}" _value)
                        cmake_path(IS_PREFIX _prefix "${_value}" NORMALIZE _inside)
                        if(NOT _inside)
                            message(FATAL_ERROR "Windows native target include escapes the admitted prefix")
                        endif()
                    elseif(_property STREQUAL "definitions")
                        if(NOT _value MATCHES "^[A-Z][A-Z0-9_]*(=[A-Za-z0-9_]+)?$")
                            message(FATAL_ERROR "Windows native target definition is not a bounded scalar macro")
                        endif()
                    elseif(NOT _value IN_LIST _required AND NOT _value MATCHES "^(advapi32|bcrypt|crypt32|gdi32|iphlpapi|normaliz|ole32|secur32|shell32|shlwapi|user32|version|winmm|ws2_32)$")
                        message(FATAL_ERROR "Windows native target link escapes the closed target/system set")
                    endif()
                    list(APPEND _values "${_value}")
                endforeach()
            endif()
            if(_property STREQUAL "includes")
                set_target_properties("${_target}" PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_values}")
            elseif(_property STREQUAL "definitions")
                set_target_properties("${_target}" PROPERTIES INTERFACE_COMPILE_DEFINITIONS "${_values}")
            else()
                if(_target STREQUAL "WebP::libwebp" AND NOT "WebP::sharpyuv" IN_LIST _values)
                    message(FATAL_ERROR "Static Windows WebP requires its explicit same-source sharpyuv target/link closure")
                endif()
                set_target_properties("${_target}" PROPERTIES INTERFACE_LINK_LIBRARIES "${_values}")
            endif()
        endforeach()
    endforeach()
    set(CLANG_BUILTINS_LIBRARY "${_builtins}" PARENT_SCOPE)
    set(FOUNDATION_NATIVE_WINDOWS_INPUTS_ADMITTED TRUE PARENT_SCOPE)
    set(FOUNDATION_NATIVE_WINDOWS_WOFF2 "${_woff2}" PARENT_SCOPE)
endfunction()
