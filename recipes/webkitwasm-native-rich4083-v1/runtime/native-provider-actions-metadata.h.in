        && providerAbiMinor == BIB_ENGINE_DOCUMENT_ACTIONS_V1_ABI_MINOR
        && hostAbiMajor == BIB_ENGINE_DOCUMENT_ACTIONS_V1_HOST_ABI_MAJOR
        && hostAbiMinor == BIB_ENGINE_DOCUMENT_ACTIONS_V1_HOST_ABI_MINOR
        && profileKind == BIB_ENGINE_DOCUMENT_ACTIONS_V1_PROFILE_KIND
        && profileKind == bib::provider_candidate::document_actions_profile
