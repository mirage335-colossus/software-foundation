constexpr bool sameOperation(const bib::provider_candidate::Operation& left,
                             const bib::provider_candidate::Operation& right) noexcept {
    return left.kind == right.kind && left.maximum_input_bytes == right.maximum_input_bytes
        && left.required_reply_capacity == right.required_reply_capacity
        && left.capability == right.capability && left.schema == right.schema;
}
constexpr bool operationsValid() noexcept {
    if (queries.size() != D::actions_queries.size() || commands.size() != D::actions_commands.size()) return false;
    for (std::size_t n = 0; n < queries.size(); ++n)
        if (!sameOperation(queries[n], D::actions_queries[n])
            || queries[n].maximum_input_bytes > limits.maximum_query_bytes
            || queries[n].required_reply_capacity > limits.maximum_reply_bytes) return false;
    for (std::size_t n = 0; n < commands.size(); ++n)
        if (!sameOperation(commands[n], D::actions_commands[n])
            || commands[n].maximum_input_bytes > limits.maximum_command_bytes
            || commands[n].required_reply_capacity > limits.maximum_reply_bytes) return false;
    return true;
}
