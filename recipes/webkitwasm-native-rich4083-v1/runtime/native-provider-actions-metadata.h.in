        && editorQueryMaximum == BIB_ENGINE_EDITOR_MAX_QUERY_BYTES
        && editorReplyCapacity == BIB_ENGINE_EDITOR_REPLY_CAPACITY
        && targetSystem == actualSystem && targetProcessor == actualProcessor
