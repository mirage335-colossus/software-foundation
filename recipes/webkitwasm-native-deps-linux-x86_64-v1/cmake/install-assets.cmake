cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/install-common.cmake")
native_copy("${NATIVE_ASSETS_FONT_CONFIG}" etc/fonts/fonts.conf)
native_copy("${NATIVE_ASSETS_ICU_DATA}" share/icu/icudt77l.dat)
native_copy("${NATIVE_ASSETS_CA_BUNDLE}" share/certs/ca-bundle.pem)
if(NOT NATIVE_ASSETS_FONTS OR NOT NATIVE_NOTICE_FILES)
  message(FATAL_ERROR "Complete admitted fonts and notices are required")
endif()
set(_font_names)
foreach(_font IN LISTS NATIVE_ASSETS_FONTS)
  cmake_path(GET _font FILENAME _name)
  if(_name IN_LIST _font_names)
    message(FATAL_ERROR "Retained fonts have colliding basenames: ${_name}")
  endif()
  list(APPEND _font_names "${_name}")
  native_copy("${_font}" "share/fonts/${_name}")
endforeach()
set(_index 0)
foreach(_notice IN LISTS NATIVE_NOTICE_FILES)
  cmake_path(GET _notice FILENAME _name)
  native_copy("${_notice}" "share/licenses/foundation-native-dependencies/${_index}-${_name}")
  math(EXPR _index "${_index} + 1")
endforeach()
# This is an empty private runtime cache, never a host/global cache build.
native_directory(var/cache/fontconfig)
