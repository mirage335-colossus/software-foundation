# This adapter intentionally never runs an upstream global install target.
if(NOT IS_ABSOLUTE "${NATIVE_PREFIX}" OR IS_SYMLINK "${NATIVE_PREFIX}")
  message(FATAL_ERROR "Install prefix must be an absolute ordinary directory")
endif()

function(native_directory relative)
  if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)" OR
     relative MATCHES "(^|/)\\.(/|$)" OR relative MATCHES "[\\\\;]")
    message(FATAL_ERROR "Invalid contained install directory: ${relative}")
  endif()
  set(_directory "${NATIVE_PREFIX}")
  if(NOT relative STREQUAL "")
    string(APPEND _directory "/${relative}")
  endif()
  cmake_path(GET NATIVE_PREFIX PARENT_PATH _prefix_parent)
  if(NOT IS_DIRECTORY "${_prefix_parent}" OR IS_SYMLINK "${_prefix_parent}")
    message(FATAL_ERROR "Install prefix parent must already be an ordinary directory")
  endif()
  # Preflight the complete owned chain before any save or permission change.
  # No directory above NATIVE_PREFIX is created or normalized by this adapter.
  set(_directories)
  set(_check "${_directory}")
  while(TRUE)
    if(IS_SYMLINK "${_check}")
      message(FATAL_ERROR "Install ancestor is a link: ${_check}")
    endif()
    if(EXISTS "${_check}" AND NOT IS_DIRECTORY "${_check}")
      message(FATAL_ERROR "Install ancestor is not a directory: ${_check}")
    endif()
    list(PREPEND _directories "${_check}")
    if(_check STREQUAL NATIVE_PREFIX)
      break()
    endif()
    cmake_path(GET _check PARENT_PATH _next)
    if(_next STREQUAL _check)
      message(FATAL_ERROR "Install directory escaped private prefix")
    endif()
    set(_check "${_next}")
  endwhile()
  # One serial owner creates and normalizes only this staged prefix. Explicit
  # 0755 modes keep complete inventories independent of the host's umask.
  foreach(_owned IN LISTS _directories)
    file(MAKE_DIRECTORY "${_owned}")
    file(CHMOD "${_owned}" PERMISSIONS
      OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE
      WORLD_READ WORLD_EXECUTE)
  endforeach()
endfunction()

function(native_copy source relative)
  if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)" OR
     relative MATCHES "(^|/)\\.(/|$)" OR relative MATCHES "[\\\\;]")
    message(FATAL_ERROR "Invalid contained install destination: ${relative}")
  endif()
  if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}" OR IS_SYMLINK "${source}")
    message(FATAL_ERROR "Required ordinary selected output is missing: ${source}")
  endif()
  file(SIZE "${source}" _size)
  if(_size EQUAL 0)
    message(FATAL_ERROR "Required selected output is empty: ${source}")
  endif()
  set(_destination "${NATIVE_PREFIX}/${relative}")
  cmake_path(GET relative PARENT_PATH _relative_parent)
  if(IS_SYMLINK "${_destination}" OR IS_DIRECTORY "${_destination}")
    message(FATAL_ERROR "Install destination is not an ordinary file: ${relative}")
  endif()
  native_directory("${_relative_parent}")
  file(COPY_FILE "${source}" "${_destination}" ONLY_IF_DIFFERENT)
  file(CHMOD "${_destination}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
endfunction()

function(native_headers source destination)
  if(NOT IS_DIRECTORY "${source}" OR IS_SYMLINK "${source}")
    message(FATAL_ERROR "Missing selected public header directory: ${source}")
  endif()
  file(GLOB_RECURSE _headers LIST_DIRECTORIES FALSE RELATIVE "${source}" "${source}/*.h")
  if(ARGC GREATER 2)
    list(FILTER _headers EXCLUDE REGEX "${ARGV2}")
  endif()
  if(NOT _headers)
    message(FATAL_ERROR "Selected header directory is empty: ${source}")
  endif()
  foreach(_header IN LISTS _headers)
    native_copy("${source}/${_header}" "${destination}/${_header}")
  endforeach()
endfunction()

function(native_icu_archive source relative)
  # Only these fixed generated ICU archive aliases are permitted. Materialize
  # one direct ordinary target inside this child's private output; never carry
  # a link into the installed prefix or dereference an arbitrary source link.
  if(IS_SYMLINK "${source}")
    file(READ_SYMLINK "${source}" _target)
    cmake_path(GET source PARENT_PATH _parent)
    cmake_path(ABSOLUTE_PATH _target BASE_DIRECTORY "${_parent}" NORMALIZE
      OUTPUT_VARIABLE _resolved)
    cmake_path(IS_PREFIX NATIVE_BINARY "${_resolved}" NORMALIZE _inside)
    if(NOT _inside OR IS_SYMLINK "${_resolved}")
      message(FATAL_ERROR "ICU generated archive alias escapes its build or chains: ${source}")
    endif()
    set(_ancestor "${_resolved}")
    while(NOT _ancestor STREQUAL NATIVE_BINARY)
      if(IS_SYMLINK "${_ancestor}")
        message(FATAL_ERROR "ICU generated archive alias has a linked ancestor: ${source}")
      endif()
      cmake_path(GET _ancestor PARENT_PATH _next)
      if(_next STREQUAL _ancestor)
        message(FATAL_ERROR "ICU generated archive alias escaped its private build")
      endif()
      set(_ancestor "${_next}")
    endwhile()
    native_copy("${_resolved}" "${relative}")
  else()
    native_copy("${source}" "${relative}")
  endif()
endfunction()

function(native_require_define source name)
  if(NOT EXISTS "${source}" OR IS_SYMLINK "${source}")
    message(FATAL_ERROR "Missing generated feature header: ${source}")
  endif()
  file(READ "${source}" _header)
  if(NOT _header MATCHES "(^|\n)[ \t]*#[ \t]*define[ \t]+${name}([ \t]+1)?[ \t]*(\n|$)")
    message(FATAL_ERROR "Required selected feature ${name} is absent in ${source}")
  endif()
endfunction()

function(native_require_cache name expected)
  if(NOT _native_cache MATCHES "(^|\n)${name}:[^=\n]*=${expected}(\n|$)")
    message(FATAL_ERROR "Selected configure setting changed: ${name}=${expected}")
  endif()
endfunction()
