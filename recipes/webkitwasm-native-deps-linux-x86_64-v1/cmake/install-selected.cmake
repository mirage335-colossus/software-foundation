cmake_minimum_required(VERSION 3.24)
foreach(_name NATIVE_COMPONENT NATIVE_SOURCE NATIVE_BINARY NATIVE_PREFIX NATIVE_PROFILE)
  if(NOT DEFINED ${_name} OR "${${_name}}" STREQUAL "")
    message(FATAL_ERROR "Missing selected installer input: ${_name}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/install-common.cmake")
file(READ "${NATIVE_PROFILE}" _profile)
string(JSON _system GET "${_profile}" components ${NATIVE_COMPONENT} build_system)
if(_system STREQUAL "cmake" OR _system STREQUAL "recipe-cmake")
  file(READ "${NATIVE_BINARY}/CMakeCache.txt" _native_cache)
  native_require_cache(CMAKE_POSITION_INDEPENDENT_CODE ON)
  native_require_cache(BUILD_SHARED_LIBS OFF)
  if(_system STREQUAL "cmake")
    string(JSON _count LENGTH "${_profile}" components ${NATIVE_COMPONENT} configure_options)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
      string(JSON _option GET "${_profile}" components ${NATIVE_COMPONENT} configure_options ${_index})
      if(_option MATCHES "^([A-Za-z0-9_]+)=(.*)$")
        set(_key "${CMAKE_MATCH_1}")
        set(_value "${CMAKE_MATCH_2}")
        # The retained curl root deliberately removes this cache entry when
        # the admitted value is 'none'. Check its generated feature below.
        if(NOT (NATIVE_COMPONENT STREQUAL "curl" AND _key STREQUAL "CURL_CA_PATH"))
          native_require_cache("${_key}" "${_value}")
        endif()
      endif()
    endforeach()
  endif()
endif()
set(_source "${NATIVE_SOURCE}")
set(_binary "${NATIVE_BINARY}")

if(NATIVE_COMPONENT STREQUAL "icu")
  foreach(_library icudata icuuc icui18n)
    native_icu_archive("${_binary}/lib/lib${_library}.a" "lib/lib${_library}.a")
  endforeach()
  native_headers("${_source}/source/common/unicode" include/unicode)
  native_headers("${_source}/source/i18n/unicode" include/unicode)
elseif(NATIVE_COMPONENT STREQUAL "zlib")
  native_copy("${_binary}/libz.a" lib/libz.a)
  native_copy("${_source}/zlib.h" include/zlib.h)
  native_copy("${_binary}/zconf.h" include/zconf.h)
elseif(NATIVE_COMPONENT STREQUAL "brotli")
  native_copy("${_binary}/libbrotlidec.a" lib/libbrotlidec.a)
  native_copy("${_binary}/libbrotlicommon.a" lib/libbrotlicommon.a)
  native_headers("${_source}/c/include/brotli" include/brotli)
elseif(NATIVE_COMPONENT STREQUAL "png")
  native_copy("${_binary}/libpng16.a" lib/libpng16.a)
  native_copy("${_source}/png.h" include/png.h)
  native_copy("${_source}/pngconf.h" include/pngconf.h)
  native_copy("${_binary}/pnglibconf.h" include/pnglibconf.h)
elseif(NATIVE_COMPONENT STREQUAL "jpeg")
  native_copy("${_binary}/libjpeg.a" lib/libjpeg.a)
  foreach(_header jpeglib.h jmorecfg.h jerror.h)
    native_copy("${_source}/${_header}" "include/${_header}")
  endforeach()
  native_copy("${_binary}/jconfig.h" include/jconfig.h)
elseif(NATIVE_COMPONENT STREQUAL "webp")
  foreach(_library webp webpdemux sharpyuv)
    native_copy("${_binary}/lib${_library}.a" "lib/lib${_library}.a")
  endforeach()
  foreach(_header decode.h encode.h demux.h types.h mux_types.h)
    native_copy("${_source}/src/webp/${_header}" "include/webp/${_header}")
  endforeach()
  native_copy("${_source}/sharpyuv/sharpyuv.h" include/webp/sharpyuv/sharpyuv.h)
  native_copy("${_source}/sharpyuv/sharpyuv_csp.h" include/webp/sharpyuv/sharpyuv_csp.h)
elseif(NATIVE_COMPONENT STREQUAL "freetype")
  native_require_define("${_binary}/include/freetype/config/ftoption.h" FT_CONFIG_OPTION_USE_BROTLI)
  native_require_define("${_binary}/include/freetype/config/ftoption.h" FT_CONFIG_OPTION_USE_PNG)
  native_require_define("${_binary}/include/freetype/config/ftoption.h" FT_CONFIG_OPTION_SYSTEM_ZLIB)
  native_copy("${_binary}/libfreetype.a" lib/libfreetype.a)
  native_headers("${_source}/include" include/freetype2 "^freetype/internal/")
  native_copy("${_binary}/include/freetype/config/ftconfig.h" include/freetype2/freetype/config/ftconfig.h)
  native_copy("${_binary}/include/freetype/config/ftoption.h" include/freetype2/freetype/config/ftoption.h)
elseif(NATIVE_COMPONENT STREQUAL "harfbuzz")
  native_require_define("${_binary}/src/hb-features.h" HB_HAS_FREETYPE)
  native_require_define("${_binary}/src/hb-features.h" HB_HAS_ICU)
  native_copy("${_binary}/libharfbuzz.a" lib/libharfbuzz.a)
  native_copy("${_binary}/libharfbuzz-icu.a" lib/libharfbuzz-icu.a)
  file(GLOB _headers RELATIVE "${_source}/src" "${_source}/src/hb*.h")
  list(FILTER _headers EXCLUDE REGEX "^hb-(subset|cairo|glib|gobject|graphite2|coretext|directwrite|gdi|uniscribe).*")
  foreach(_header IN LISTS _headers)
    native_copy("${_source}/src/${_header}" "include/harfbuzz/${_header}")
  endforeach()
  native_copy("${_binary}/src/hb-features.h" include/harfbuzz/hb-features.h)
elseif(NATIVE_COMPONENT STREQUAL "xml2")
  native_require_define("${_binary}/libxml/xmlversion.h" LIBXML_SAX1_ENABLED)
  native_copy("${_binary}/libxml2.a" lib/libxml2.a)
  native_headers("${_source}/include/libxml" include/libxml2/libxml)
  native_copy("${_binary}/libxml/xmlversion.h" include/libxml2/libxml/xmlversion.h)
elseif(NATIVE_COMPONENT STREQUAL "sqlite")
  native_copy("${_binary}/libsqlite3.a" lib/libsqlite3.a)
  native_copy("${_source}/sqlite3.h" include/sqlite3.h)
  native_copy("${_source}/sqlite3ext.h" include/sqlite3ext.h)
elseif(NATIVE_COMPONENT STREQUAL "openssl")
  native_copy("${_binary}/libssl.a" lib/libssl.a)
  native_copy("${_binary}/libcrypto.a" lib/libcrypto.a)
  native_headers("${_source}/include/openssl" include/openssl)
  # Generated configuration and API headers are part of the public native ABI.
  native_headers("${_binary}/include/openssl" include/openssl)
elseif(NATIVE_COMPONENT STREQUAL "nghttp2")
  native_copy("${_binary}/lib/libnghttp2.a" lib/libnghttp2.a)
  native_headers("${_source}/lib/includes/nghttp2" include/nghttp2)
  native_copy("${_binary}/lib/includes/nghttp2/nghttp2ver.h" include/nghttp2/nghttp2ver.h)
elseif(NATIVE_COMPONENT STREQUAL "psl")
  native_copy("${_binary}/src/.libs/libpsl.a" lib/libpsl.a)
  native_copy("${_binary}/include/libpsl.h" include/libpsl.h)
elseif(NATIVE_COMPONENT STREQUAL "curl")
  # USE_NGHTTP2 is downgraded locally by upstream if discovery fails. Its cache
  # option alone cannot prove the selected compiled HTTP/2 feature survived.
  foreach(_feature USE_NGHTTP2 USE_OPENSSL HAVE_LIBZ HAVE_BROTLI USE_LIBPSL USE_THREADS_POSIX)
    native_require_define("${_binary}/lib/curl_config.h" "${_feature}")
  endforeach()
  file(READ "${_binary}/lib/curl_config.h" _curl_header)
  if(_curl_header MATCHES "(^|\n)[ \t]*#[ \t]*define[ \t]+CURL_CA_PATH[ \t]")
    message(FATAL_ERROR "curl unexpectedly selected a default CA directory")
  endif()
  native_copy("${_binary}/lib/libcurl.a" lib/libcurl.a)
  native_headers("${_source}/include/curl" include/curl)
elseif(NATIVE_COMPONENT STREQUAL "fontconfig")
  native_require_define("${_binary}/config.h" ENABLE_LIBXML2)
  file(READ "${_binary}/Makefile" _font_makefile)
  foreach(_setting JSONC_CFLAGS JSONC_LIBS)
    if(NOT _font_makefile MATCHES "(^|\n)${_setting}[ \t]*=[ \t]*(\n|$)")
      message(FATAL_ERROR "Fontconfig unexpectedly selected json-c: ${_setting}")
    endif()
  endforeach()
  native_copy("${_binary}/src/.libs/libfontconfig.a" lib/libfontconfig.a)
  foreach(_header fontconfig.h fcfreetype.h fcprivate.h)
    native_copy("${_source}/fontconfig/${_header}" "include/fontconfig/${_header}")
  endforeach()
else()
  message(FATAL_ERROR "Unknown fixed native dependency component: ${NATIVE_COMPONENT}")
endif()

# A small explicit .pc contract avoids global upstream installs and records the
# actual selected static closure, including FreeType/Brotli and ICU C++ runtime.
string(JSON _pc_count LENGTH "${_profile}" pkg_config)
math(EXPR _pc_last "${_pc_count} - 1")
foreach(_index RANGE 0 ${_pc_last})
  string(JSON _relative MEMBER "${_profile}" pkg_config ${_index})
  string(JSON _owner GET "${_profile}" pkg_config "${_relative}" component)
  if(NOT _owner STREQUAL NATIVE_COMPONENT)
    continue()
  endif()
  foreach(_field version library requires_private libs_private include_subdir definitions)
    string(JSON _${_field} GET "${_profile}" pkg_config "${_relative}" ${_field})
  endforeach()
  if(NATIVE_COMPONENT STREQUAL "freetype")
    file(READ "${_binary}/freetype2.pc" _upstream_pc)
    if(NOT _upstream_pc MATCHES "(^|\n)Version:[ \t]*${_version}(\n|$)")
      message(FATAL_ERROR "FreeType's generated pkg-config API version changed")
    endif()
  endif()
  cmake_path(GET _relative STEM _name)
  set(_pc "prefix=\${pcfiledir}/../..\nexec_prefix=\${prefix}\nlibdir=\${prefix}/lib\nincludedir=\${prefix}/include\n\nName: ${_name}\nDescription: Retained native static ${_name}\nVersion: ${_version}\nLibs: -L\${libdir} -l${_library}\nLibs.private: ${_libs_private}\nRequires.private: ${_requires_private}\nCflags: -I\${includedir}")
  if(NOT _include_subdir STREQUAL "")
    string(APPEND _pc "/${_include_subdir}")
  endif()
  string(APPEND _pc " ${_definitions}\n")
  set(_temporary "${_binary}/foundation-${_name}.pc")
  file(WRITE "${_temporary}" "${_pc}")
  native_copy("${_temporary}" "${_relative}")
endforeach()
