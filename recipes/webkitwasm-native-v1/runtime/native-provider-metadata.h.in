namespace foundation::appended::native_provider_metadata {
using Digest = std::array<std::uint8_t, 32>;
namespace D = bib::provider_candidate::document_catalog;
inline constexpr std::uint32_t providerAbiMajor = 1, providerAbiMinor = 1;
inline constexpr std::uint32_t hostAbiMajor = 1, hostAbiMinor = 0;
inline constexpr std::uint32_t documentProfile = bib::provider_candidate::document_pixel_profile;
inline constexpr std::uint32_t targetProcessor = @TARGET_PROCESSOR@;
inline constexpr Digest baseHeaderSha256{@BASE_SHA256_BYTES@};
inline constexpr Digest extensionHeaderSha256{@EXTENSION_SHA256_BYTES@};
inline constexpr Digest contractSha256{@CONTRACT_SHA256_BYTES@};
inline constexpr Digest catalogSha256{@CATALOG_SHA256_BYTES@};
inline constexpr Digest documentSchemaSha256{@SCHEMA_SHA256_BYTES@};
inline constexpr Digest ackSchemaSha256{@ACK_SHA256_BYTES@};
inline constexpr Digest sourceRecipeSha256{@SOURCE_RECIPE_SHA256_BYTES@};
inline constexpr Digest buildIdentitySha256{@BUILD_IDENTITY_SHA256_BYTES@};
inline constexpr Digest sourceInputsSha256{@SOURCE_INPUTS_SHA256_BYTES@};
inline constexpr Digest toolchainIdentitySha256{@TOOLCHAIN_IDENTITY_SHA256_BYTES@};

constexpr BibEngineBuildV1 makeBuild() noexcept {
    BibEngineBuildV1 value{};
    value.size = sizeof(value);
    value.layout_revision = BIB_ENGINE_LAYOUT_V1;
    value.target_system = BIB_ENGINE_TARGET_LINUX;
    value.target_processor = targetProcessor;
    value.pointer_bits = 64;
    value.lifetime = BIB_ENGINE_LIFETIME_PROCESS;
    value.maximum_starts = 1;
    value.reserved = 0;
    value.fixed_viewport_width = 800;
    value.fixed_viewport_height = 600;
    value.capabilities = UINT64_C(1795);
    for (std::size_t n = 0; n < 32; ++n) {
        value.contract_header_sha256[n] = contractSha256[n];
        value.build_identity_sha256[n] = buildIdentitySha256[n];
        value.source_recipe_sha256[n] = sourceRecipeSha256[n];
    }
    return value;
}
inline constexpr BibEngineBuildV1 build = makeBuild();
inline constexpr BibEngineLimitsV1 limits{
    sizeof(BibEngineLimitsV1), 65536, 65536, 1048576, 1048576,
    8, 64, 0, UINT64_C(67108864), UINT64_C(134217728)};
// Exact values from the source-recipe-bound prelink config, never a CLI default.
inline constexpr bib::provider_candidate::ServiceRetentionLimits retention{64, 4194304};

constexpr bool nonzero(const Digest& value) noexcept {
    for (auto byte : value) if (byte) return true;
    return false;
}
constexpr bool rawDigestMatches(const std::uint8_t (&actual)[32], const Digest& expected) noexcept {
    for (std::size_t n = 0; n < 32; ++n) if (actual[n] != expected[n]) return false;
    return true;
}
constexpr bool metadataValid() noexcept {
#if defined(__x86_64__) && !defined(__aarch64__)
    constexpr auto actualProcessor = BIB_ENGINE_CPU_X86_64;
#elif defined(__aarch64__) && !defined(__x86_64__)
    constexpr auto actualProcessor = BIB_ENGINE_CPU_AARCH64;
#else
    constexpr auto actualProcessor = 0u;
#endif
    return sizeof(void*) == 8 && sizeof(std::uintptr_t) == 8
        && std::endian::native == std::endian::little
        && providerAbiMajor == BIB_ENGINE_DOCUMENT_V2_ABI_MAJOR
        && providerAbiMinor == BIB_ENGINE_DOCUMENT_V2_ABI_MINOR
        && hostAbiMajor == BIB_ENGINE_DOCUMENT_V2_HOST_ABI_MAJOR
        && hostAbiMinor == BIB_ENGINE_DOCUMENT_V2_HOST_ABI_MINOR
        && documentProfile == bib::provider_candidate::document_pixel_profile
        && targetProcessor == actualProcessor
        && baseHeaderSha256 == D::base_header && extensionHeaderSha256 == D::extension_header
        && contractSha256 == D::contract && catalogSha256 == D::catalog
        && documentSchemaSha256 == D::schema && ackSchemaSha256 == D::ack_schema
        && nonzero(sourceRecipeSha256) && nonzero(buildIdentitySha256)
        && nonzero(sourceInputsSha256) && nonzero(toolchainIdentitySha256)
        && build.size == 144 && build.layout_revision == BIB_ENGINE_LAYOUT_V1
        && build.target_system == BIB_ENGINE_TARGET_LINUX
        && build.target_processor == actualProcessor && build.pointer_bits == 64
        && build.lifetime == BIB_ENGINE_LIFETIME_PROCESS && build.maximum_starts == 1
        && !build.reserved && build.fixed_viewport_width == 800 && build.fixed_viewport_height == 600
        && build.capabilities == D::capabilities && build.capabilities == UINT64_C(1795)
        && rawDigestMatches(build.contract_header_sha256, contractSha256)
        && rawDigestMatches(build.build_identity_sha256, buildIdentitySha256)
        && rawDigestMatches(build.source_recipe_sha256, sourceRecipeSha256)
        && limits.size == 48 && limits.maximum_command_bytes == 65536
        && limits.maximum_query_bytes == 65536 && limits.maximum_reply_bytes == 1048576
        && limits.maximum_service_message_bytes == 1048576
        && limits.maximum_retired_documents == 8 && limits.maximum_inflight_resources == 64
        && !limits.reserved && limits.maximum_resource_response_bytes == UINT64_C(67108864)
        && limits.maximum_retained_resource_bytes == UINT64_C(134217728)
        && retention.max_retained_calls == 64 && retention.max_retained_bytes == 4194304;
}
static_assert(std::is_standard_layout_v<BibEngineBuildV1> && std::is_standard_layout_v<BibEngineProviderV1>);
static_assert(sizeof(BibEngineBytesV1) == 16 && sizeof(BibEngineDocumentV1) == 24);
static_assert(sizeof(BibEngineBuildV1) == 144 && alignof(BibEngineBuildV1) == 8);
static_assert(offsetof(BibEngineBuildV1, capabilities) == 40);
static_assert(offsetof(BibEngineBuildV1, contract_header_sha256) == 48);
static_assert(offsetof(BibEngineBuildV1, build_identity_sha256) == 80);
static_assert(offsetof(BibEngineBuildV1, source_recipe_sha256) == 112);
static_assert(sizeof(BibEngineLimitsV1) == 48 && alignof(BibEngineLimitsV1) == 8);
static_assert(sizeof(BibEngineDamageV1) == 72 && sizeof(BibEngineResourceRequestV1) == 48);
static_assert(sizeof(BibEngineResourceResponseV1) == 56 && sizeof(BibEngineResourceEpochV1) == 40);
static_assert(sizeof(BibEngineHostV1) == 128 && alignof(BibEngineHostV1) == 8);
static_assert(sizeof(BibEngineStartV1) == 136 && sizeof(BibEngineStartResultV1) == 16);
static_assert(sizeof(BibEngineAdvanceV1) == 16 && sizeof(BibEngineReplyBufferV1) == 16);
static_assert(sizeof(BibEngineCommandV1) == 88 && sizeof(BibEngineQueryV1) == 80);
static_assert(sizeof(BibEngineCommandResultV1) == 24 && sizeof(BibEngineQueryResultV1) == 40);
static_assert(sizeof(BibEngineProviderV1) == 272 && alignof(BibEngineProviderV1) == 8);
static_assert(offsetof(BibEngineProviderV1, build) == 16);
static_assert(offsetof(BibEngineProviderV1, limits) == 160);
static_assert(offsetof(BibEngineProviderV1, start) == 208);
static_assert(offsetof(BibEngineProviderV1, dispose_retired_service_document) == 264);
